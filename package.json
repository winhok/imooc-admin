{
  "name": "imooc-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "commit": "cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@antv/g2": "5.4.8",
    "@antv/s2": "2.7.2",
    "@element-plus/icons-vue": "^2.3.2",
    "@toast-ui/editor": "3.2.2",
    "axios": "^1.18.1",
    "countup.js": "2.10.1",
    "culori": "4.0.2",
    "dayjs": "1.11.21",
    "dompurify": "^3.4.12",
    "driver.js": "^1.7.0",
    "echarts": "6.1.0",
    "element-plus": "^2.14.3",
    "file-saver": "2.0.5",
    "fuse.js": "^7.5.0",
    "i18next": "26.3.6",
    "md5": "^2.3.0",
    "path-browserify": "^1.0.1",
    "pinia": "^4.0.2",
    "screenfull": "^6.0.2",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.2.0",
    "vue3-print-nb": "0.1.4",
    "wangeditor": "4.7.15",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/culori": "4.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/md5": "^2.3.6",
    "@types/node": "^26.1.1",
    "@types/path-browserify": "^1.0.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "4.3.2",
    "cz-customizable": "7.5.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.74.0",
    "postcss-html": "^1.8.1",
    "prettier": "3.9.5",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^26.3.0"
  },
  "packageManager": "pnpm@11.13.1",
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "lint-staged": {
    "*.{vue,ts,mts,tsx}": [
      "oxlint --fix",
      "eslint --fix --cache",
      "prettier --write --experimental-cli"
    ],
    "*.{js,cjs,mjs,jsx,json,jsonc,css,scss,less,md,yml,yaml,html}": [
      "prettier --write --experimental-cli"
    ]
  },
  "description": "This template should help get you started developing with Vue 3 in Vite.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winhok/imooc-admin.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/winhok/imooc-admin/issues"
  },
  "homepage": "https://github.com/winhok/imooc-admin#readme"
}
